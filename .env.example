# Copie este arquivo para ".env" e ajuste os valores.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Porta do servidor HTTP (só usada localmente; a Vercel ignora)
PORT=3000

# Conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_manager
# Supabase (Connect > Connection string > "Transaction pooler", porta 6543):
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# SSL: vazio = automático (localhost sem SSL, remoto com SSL). Use true/false para forçar.
DATABASE_SSL=

# Fuso horário usado nas regras de data (prazo x data de criação)
APP_TIMEZONE=America/Sao_Paulo
